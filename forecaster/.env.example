# Copy to .env (gitignored) and fill in. Never commit real values.

# Claude subscription OAuth token. Mint with: claude setup-token
# ANTHROPIC_API_KEY must stay UNSET — if present it shadows this token and bills per-token.
CLAUDE_CODE_OAUTH_TOKEN=

# SMTP delivery. Gmail requires an app password, not the account password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
