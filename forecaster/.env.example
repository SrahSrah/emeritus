# Copy to .env (gitignored) and fill in. Never commit real values.

# Claude subscription OAuth token. Mint with: claude setup-token
# ANTHROPIC_API_KEY must stay UNSET — if present it shadows this token and bills per-token.
CLAUDE_CODE_OAUTH_TOKEN=

# Contact email substituted into ${CONTACT_EMAIL} in config.toml (outbound User-Agent
# headers — api.weather.gov asks for a contact — and the fake deliverer's label).
# Not a credential, but it is YOUR address: set it here, not in the tracked config.
CONTACT_EMAIL=your.email@example.com

# SMTP delivery. Gmail requires an app password, not the account password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
